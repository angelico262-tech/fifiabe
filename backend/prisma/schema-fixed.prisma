generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  DRIVER
}

enum Direction {
  SAVA_TO_TANA
  TANA_TO_SAVA
}

enum TripStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(DRIVER)
  createdAt    DateTime @default(now())
}

model Route {
  id        String      @id @default(cuid())
  name      String
  direction Direction   @unique
  stops     RouteStop[]
  trips     Trip[]
}

model Stop {
  id         String      @id @default(cuid())
  name       String      @unique
  routeStops RouteStop[]
}

model RouteStop {
  routeId String
  stopId  String
  order   Int
  route   Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@id([routeId, stopId])
  @@unique([routeId, order])
}

model Vehicle {
  id       String  @id @default(cuid())
  code     String  @unique
  capacity Int     @default(17)
  trips    Trip[]
}

model Trip {
  id          String     @id @default(cuid())
  departureAt DateTime
  priceAr     Int        @default(50000)
  status      TripStatus @default(SCHEDULED)
  routeId     String
  vehicleId   String
  route       Route      @relation(fields: [routeId], references: [id])
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  bookings    Booking[]

  @@unique([departureAt, routeId, vehicleId])
  @@index([departureAt, routeId])
}

model Booking {
  id             String   @id @default(cuid())
  passengerName  String
  passengerPhone String
  seats          Int      @default(1)
  tripId         String
  createdAt      DateTime @default(now())
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
